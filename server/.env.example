# ==============================================================================
# 泰山職訓 本地開發環境變數設定範例 (.env.example)
# 若希望本地開發時也直連 Cloudinary 雲端圖床，可將本檔複製為 .env 並填寫您的金鑰
# ==============================================================================

# 方式 A：直接貼上 Cloudinary Dashboard 官方提供的 CLOUDINARY_URL (最推薦)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@do3mfqhlg

# 方式 B：分開填寫三大欄位
# CLOUDINARY_CLOUD_NAME=do3mfqhlg
# CLOUDINARY_API_KEY=您的API金鑰
# CLOUDINARY_API_SECRET=您的API密鑰
