# ==============================================================================
# 泰山職訓「前端網頁技術與AI應用」招生專案 .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python / Django 忽略清單
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虛擬環境
venv/
env/
ENV/
env.bak/
venv.bak/
server/venv/

# Django 運行與產出檔案
server/db.sqlite3
server/db.sqlite3-journal
server/staticfiles/
server/media/*
!server/media/.gitkeep
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
.env
.env.*
server/.env
server/.env.*
!.env.example
!server/.env.example

# ------------------------------------------------------------------------------
# Node.js / Vue 3 / Vite 忽略清單
# ------------------------------------------------------------------------------
node_modules/
client/node_modules/
client/dist/
dist/
dist-ssr/
*.local
client/.env.local
client/.env.*.local
client/.vite/
.vite/

# NPM / Yarn / PNPM 日誌
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 編輯器與作業系統暫存檔
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
tempCodeRunnerFile.*

# 內部專案規格、需求文件與本地使用手冊目錄 (禁止上傳 GitHub，僅限本地留存)
# ------------------------------------------------------------------------------
docs/
泰山職訓招生網站規格需求書*.md
系統操作與維護手冊*.md
USER_MANUAL*.md


